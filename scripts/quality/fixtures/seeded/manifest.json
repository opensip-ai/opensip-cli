{
  "version": 1,
  "id": "seeded",
  "description": "Redistributable seeded corpus for detection-quality measurement.",
  "cases": [
    {
      "id": "typescript-no-any-positive",
      "language": "typescript",
      "rationale": "A TypeScript annotation using any should be reported.",
      "files": [
        {
          "path": "src/no-any-positive.ts",
          "content": "export function parsePayload(payload: any): unknown {\n  return payload;\n}\n"
        }
      ],
      "targetPaths": ["src/no-any-positive.ts"],
      "checks": [{ "slug": "no-any-types", "expectFinding": true }]
    },
    {
      "id": "typescript-no-any-negative",
      "language": "typescript",
      "rationale": "An unknown annotation with narrowing should not be reported as any.",
      "files": [
        {
          "path": "src/no-any-negative.ts",
          "content": "export function parsePayload(payload: unknown): string {\n  return typeof payload === 'string' ? payload : '';\n}\n"
        }
      ],
      "targetPaths": ["src/no-any-negative.ts"],
      "checks": [{ "slug": "no-any-types", "expectFinding": false }]
    },
