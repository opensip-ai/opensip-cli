{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ast-grep",
          "version": "0.25.7",
          "informationUri": "https://ast-grep.github.io",
          "rules": [
            {
              "id": "no-console-log",
              "shortDescription": { "text": "Avoid console.log in production code" }
            },
            {
              "id": "no-debugger",
              "shortDescription": { "text": "Remove debugger statements" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "no-console-log",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "console.log call found" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/a.ts" },
                "region": { "startLine": 3, "startColumn": 5 }
              }
            }
          ]
        },
        {
          "ruleId": "no-debugger",
          "ruleIndex": 1,
          "level": "error",
          "message": { "text": "debugger statement found" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/b.ts" },
                "region": { "startLine": 10, "startColumn": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
