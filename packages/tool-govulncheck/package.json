{
  "name": "@opensip-cli/tool-govulncheck",
  "version": "0.5.1",
  "license": "Apache-2.0",
  "description": "External Tool Adapter for govulncheck — wraps Go vulnerability scanning as an opensip-cli tool",
  "keywords": [
    "opensip-cli",
    "static-analysis",
    "code-quality",
    "external-tool-adapter",
    "scanner",
    "go",
    "golang",
    "govulncheck",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opensip-ai/opensip-cli.git",
    "directory": "packages/tool-govulncheck"
  },
  "homepage": "https://github.com/opensip-ai/opensip-cli",
  "bugs": {
    "url": "https://github.com/opensip-ai/opensip-cli/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "opensipTools": {
    "kind": "tool",
    "id": "govulncheck",
    "identity": {
      "name": "govulncheck"
    },
    "stableId": "13862491-ff5c-412e-b1fa-5a2856c73a4a",
    "apiVersion": 1,
    "commands": [
      {
        "name": "govulncheck",
        "description": "Run govulncheck across Go packages",
        "aliases": [],
        "commonFlags": [
          "json",
          "cwd",
          "quiet",
          "verbose",
          "debug",
          "reportTo",
          "apiKey",
          "open"
        ],
        "options": [
          {
            "flag": "--gate-save",
            "description": "Architecture-gate: save current findings as baseline in the project SQLite store (mutually exclusive with --gate-compare)",
            "default": false
          },
          {
            "flag": "--gate-compare",
            "description": "Architecture-gate: compare current findings against the saved baseline; exit 1 on regression",
            "default": false
          }
        ],
        "scope": "project",
        "output": "raw-stream",
        "rawStreamReason": "runtime-render-dispatch",
        "producesVerdict": true
      },
      {
        "name": "doctor",
        "description": "Check that the govulncheck binary is installed and ready",
        "parent": "govulncheck",
        "commonFlags": [
          "json",
          "cwd"
        ],
        "scope": "none",
        "output": "raw-stream",
        "rawStreamReason": "diagnostic-gate"
      },
      {
        "name": "version",
        "description": "Print the resolved govulncheck binary version",
        "parent": "govulncheck",
        "commonFlags": [
          "json",
          "cwd"
        ],
        "scope": "none",
        "output": "raw-stream",
        "rawStreamReason": "diagnostic-gate"
      }
    ],
    "requires": [
      {
        "resource": "subprocess",
        "reason": "Executes the user-installed govulncheck binary via execFile (no shell)"
      },
      {
        "resource": "filesystem",
        "reason": "Reads the project working tree and writes the raw scan artifact under .runtime/artifacts"
      },
      {
        "resource": "network",
        "reason": "Performs network I/O for the networked scanner posture"
      }
    ],
    "config": {
      "namespace": "govulncheck",
      "schema": {
        "type": "object",
        "properties": {
          "binaries": {
            "type": "object"
          }
        }
      }
    },
    "languages": [
      "go"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opensip-cli/core": "workspace:*",
    "@opensip-cli/external-tool-adapter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
