{
  "//": "Generated by scripts/build-test-tsconfigs.mjs — do not edit by hand. Run `pnpm typecheck:tests:sync`; CI enforces sync via `pnpm typecheck:tests:check`.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__fixtures__/**",
    "**/__tests__/fixtures/**"
  ]
}
