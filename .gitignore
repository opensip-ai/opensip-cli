# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test
coverage/

# Turbo
.turbo/

# Performance SLO benchmark artifacts
.opensip-slo/
slo-report*.json

# Local performance profiling and toolchain benchmark artifacts
.opensip-profile/
profile-report*.json
profile-report*.md
toolchain-report*.json
toolchain-report*.md
*.cpuprofile
opensip-profile-*.labels.json

# Detection quality measurement artifacts
.opensip-quality/
detection-quality-report*.json

# Packed distribution measurement artifacts
.opensip-distribution/
/distribution-footprint-report*.json

# Agent-usability evaluation reports
packages/agent-eval/results/

# Compatibility matrix artifacts
compatibility-matrix-report*.json

# Dogfood SARIF outputs at the repo root (fit:ci / graph:ci / yagni:ci write
# these; they are regenerated by CI). The tracked golden SARIF fixtures live
# under packages/**/__fixtures__/ and are NOT matched by this root-anchored rule.
/*.sarif

# In-repo git worktrees (parallel sessions). Tracked via .git/worktrees;
# ignoring the checkout dir prevents accidental `git add` of a worktree.
.worktrees/

# Logs
*.log

# Packed tarballs (from `pnpm pack` / `npm pack`)
*.tgz

# Accidental pack destination when a path env/arg is missing and becomes the
# JS string "undefined" (e.g. `pnpm pack --pack-destination $UNSET`). Contents
# are already covered by `*.tgz`; ignore the directory itself so it never
# appears as untracked noise at the repo root.
/undefined/

# v3 per-project runtime state — sessions, logs, dashboard reports,
# baselines, AST cache, plugin installs. Test fixtures, the
# opensip-cli repo itself, and any consumer all generate this.
opensip-cli/.runtime/
**/opensip-cli/.runtime/

# Local-only docs content (kept out of the repo)
docs/ai-helpers/
docs/examples/
docs/plans/

# Private local strategy and working context. Never commit or publish content
# from this directory.
docs/internal/

# Ephemeral remediation artifacts from the Correctness Remediation Process.
# These contain per-round findings, coverage reports, and the final summary.
# They are created inside worktrees during remediation runs and are never
# committed to the main repository.
docs/remediation/

# Claude Code session state
.claude/scheduled_tasks.lock
